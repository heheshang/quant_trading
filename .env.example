# 数据库配置
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=quant_trading
DATABASE_MAX_CONNECTIONS=50

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20

# 交易配置
ENABLE_PAPER_TRADING=true
MAX_ORDERS_PER_SECOND=100
DEFAULT_COMMISSION_RATE=0.0003
DEFAULT_SLIPPAGE=0.0001

# 风控配置
MAX_POSITION_SIZE=0.2
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.15

# 监控配置
LOG_LEVEL=info
LOG_DIR=./logs
SERVICE_NAME=quant-trading
ENABLE_JSON_LOGGING=false
ENABLE_FILE_LOGGING=true
ENABLE_STDOUT_LOGGING=true
PROMETHEUS_PORT=9090

# Binance 交易所配置（所有 URL 均由环境变量注入；BINANCE_ENVIRONMENT 决定路径布局 /api/v3 或 /fapi/v1）
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENVIRONMENT=spot  # spot 或 futures
BINANCE_ENABLE=false  # true 启用 Binance 集成
# 请求地址（留空则按 BINANCE_ENVIRONMENT 取对应默认值）
BINANCE_BASE_URL=
BINANCE_WS_URL=
#   现货生产:  BINANCE_BASE_URL=https://api.binance.com
#              BINANCE_WS_URL=wss://stream.binance.com:9443/stream
#   现货测试网: BINANCE_BASE_URL=https://testnet.binance.vision
#              BINANCE_WS_URL=wss://stream.testnet.binance.vision:9443/stream
#   期货生产:  BINANCE_BASE_URL=https://fapi.binance.com
#              BINANCE_WS_URL=wss://fstream.binance.com/stream
#   期货测试网: BINANCE_BASE_URL=https://testnet.binancefuture.com
#              BINANCE_WS_URL=wss://stream.binancefuture.com/stream
# 签名方式：hmac（默认）或 ed25519（需 BINANCE_PRIVATE_KEY_PATH 指向 Ed25519 私钥 PEM）
BINANCE_KEY_TYPE=hmac
BINANCE_PRIVATE_KEY_PATH=

# 调度与数据拉取
DATA_PULLER_ENABLED=false
DATA_PULLER_SYMBOLS=BTC-USDT,ETH-USDT
# 策略调度器默认开启（代码默认 true）；设为 false 可关闭
SCHEDULER_ENABLED=true
OPTIMIZER_ENABLED=false

# 加密密钥（生产环境请务必修改）
ENCRYPTION_KEY=change_this_encryption_key_in_production
JWT_SECRET=change_this_jwt_secret_in_production

# ── 其余可覆盖项（AppConfig::from_env 读取） ──
# 数据库
DATABASE_CONNECT_TIMEOUT_SECONDS=3
# 交易
ORDER_TIMEOUT_SECONDS=30
SIMULATION_DELAY_MS=30000
# 风控
MAX_CONCENTRATION=0.2
ENABLE_PRE_TRADE_CHECK=true
ENABLE_REAL_TIME_MONITOR=true
VAR_CONFIDENCE_LEVEL=0.95
# 监控
ENABLE_PROMETHEUS=true
ALERT_EMAIL=
ALERT_WEBHOOK=
# 安全
ENABLE_ENCRYPTION=true
TOKEN_EXPIRY_HOURS=24
ENABLE_2FA=false
ALLOWED_IPS=127.0.0.1
